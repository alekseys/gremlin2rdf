<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.alekseys.gremlin2rdf</groupId><artifactId>migration-parent</artifactId><version>0.1.0</version></parent>
  <artifactId>graph-testkit</artifactId>
  <dependencies>
    <dependency><groupId>io.github.alekseys.gremlin2rdf</groupId><artifactId>migration-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.apache.jena</groupId><artifactId>jena-fuseki-main</artifactId><version>${jena.version}</version></dependency>
    <dependency><groupId>org.apache.jena</groupId><artifactId>jena-tdb2</artifactId><version>${jena.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
    <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
      <createDependencyReducedPom>false</createDependencyReducedPom>
      <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude></excludes></filter></filters>
      <transformers>
        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.github.gremlin2rdf.testkit.Benchmark</mainClass></transformer>
      </transformers>
    </configuration></execution></executions>
  </plugin></plugins></build>
</project>
