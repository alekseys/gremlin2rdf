{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": ["progress", "result", "error"]
    },
    "runId": {
      "type": "string"
    },
    "operationId": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "payload": {}
  },
  "required": ["protocolVersion", "sequence", "type", "runId", "operationId", "phase", "payload"],
  "additionalProperties": false
}
