{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "fixture",
            "translate",
            "extract",
            "load",
            "resume",
            "query",
            "validate",
            "assess",
            "rewrite-plan",
            "rewrite-apply",
            "authorize",
            "authorize-rewrite"
          ]
        },
        "expectedResourceHash": {
          "default": "",
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "start"
        },
        "project": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "migrationKind": {
              "type": "string",
              "const": "cosmos-gremlin-to-age"
            },
            "runId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-]{1,80}$"
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "host": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9.-]+$"
                    },
                    "database": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "container": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "partitionKeyPath": {
                      "type": "string",
                      "pattern": "^\\/[^/]{1,255}$"
                    },
                    "authenticationRef": {
                      "type": "string",
                      "pattern": "^env:AGE_[A-Z0-9_]+$"
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "host",
                    "database",
                    "container",
                    "partitionKeyPath",
                    "authenticationRef",
                    "scope"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "host": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "database": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "username": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "authenticationRef": {
                      "type": "string",
                      "pattern": "^env:AGE_[A-Z0-9_]+$"
                    },
                    "graph": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,47}$"
                    },
                    "ledgerSchema": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,47}$"
                    },
                    "sslMode": {
                      "type": "string",
                      "const": "VerifyFull"
                    }
                  },
                  "required": [
                    "host",
                    "port",
                    "database",
                    "username",
                    "authenticationRef",
                    "graph",
                    "ledgerSchema",
                    "sslMode"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "consistency": {
              "type": "string",
              "enum": [
                "quiesced",
                "immutable"
              ]
            },
            "limits": {
              "type": "object",
              "properties": {
                "batchRecords": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "batchBytes": {
                  "type": "integer",
                  "minimum": 262144,
                  "maximum": 16777216
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120
                },
                "maximumOperationSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              },
              "required": [
                "batchRecords",
                "batchBytes",
                "timeoutSeconds",
                "maximumOperationSeconds"
              ],
              "additionalProperties": false
            },
            "approvals": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "load",
                      "crud",
                      "rewrite"
                    ]
                  },
                  "inputHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "runId": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "resourceHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "expiresAt": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "operation",
                  "inputHash",
                  "runId",
                  "target",
                  "resourceHash",
                  "expiresAt",
                  "signature"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "migrationKind",
            "runId",
            "source",
            "target",
            "consistency",
            "limits",
            "approvals"
          ],
          "additionalProperties": false
        },
        "input": {
          "type": "string",
          "maxLength": 16384
        },
        "output": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "required": [
        "protocolVersion",
        "sequence",
        "runId",
        "operationId",
        "inputHash",
        "operation",
        "expectedResourceHash",
        "type",
        "project",
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "fixture",
            "translate",
            "extract",
            "load",
            "resume",
            "query",
            "validate",
            "assess",
            "rewrite-plan",
            "rewrite-apply",
            "authorize",
            "authorize-rewrite"
          ]
        },
        "expectedResourceHash": {
          "default": "",
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "pause",
            "cancel"
          ]
        },
        "project": {
          "type": "null"
        },
        "input": {
          "type": "string",
          "const": ""
        },
        "output": {
          "type": "string",
          "const": ""
        }
      },
      "required": [
        "protocolVersion",
        "sequence",
        "runId",
        "operationId",
        "inputHash",
        "operation",
        "expectedResourceHash",
        "type",
        "project",
        "input",
        "output"
      ],
      "additionalProperties": false
    }
  ]
}
