{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["vertex", "edge"]
    },
    "identity": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
            },
            "lexical": {
              "type": "string"
            }
          },
          "required": ["type", "lexical"],
          "additionalProperties": false
        },
        "id": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
            },
            "lexical": {
              "type": "string"
            }
          },
          "required": ["type", "lexical"],
          "additionalProperties": false
        }
      },
      "required": ["scope", "partition", "id"],
      "additionalProperties": false
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
                },
                "lexical": {
                  "type": "string"
                }
              },
              "required": ["type", "lexical"],
              "additionalProperties": false
            },
            "id": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
                },
                "lexical": {
                  "type": "string"
                }
              },
              "required": ["type", "lexical"],
              "additionalProperties": false
            }
          },
          "required": ["scope", "partition", "id"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
                },
                "lexical": {
                  "type": "string"
                }
              },
              "required": ["type", "lexical"],
              "additionalProperties": false
            },
            "id": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
                },
                "lexical": {
                  "type": "string"
                }
              },
              "required": ["type", "lexical"],
              "additionalProperties": false
            }
          },
          "required": ["scope", "partition", "id"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "edgeScope": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["sourcePartition", "sourceVertex"]
        },
        {
          "type": "null"
        }
      ]
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
              },
              "lexical": {
                "type": "string"
              }
            },
            "required": ["type", "lexical"],
            "additionalProperties": false
          },
          "id": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
                  },
                  "lexical": {
                    "type": "string"
                  }
                },
                "required": ["type", "lexical"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "metaProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
                },
                "lexical": {
                  "type": "string"
                }
              },
              "required": ["type", "lexical"],
              "additionalProperties": false
            }
          },
          "fidelity": {
            "type": "string",
            "enum": ["complete", "reduced"]
          }
        },
        "required": ["key", "value", "id", "metaProperties", "fidelity"],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
          },
          "lexical": {
            "type": "string"
          }
        },
        "required": ["type", "lexical"],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "shard": {
          "type": "string"
        },
        "sourceManifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consistency": {
          "type": "string",
          "enum": ["quiesced", "immutable", "best-effort"]
        },
        "fidelity": {
          "type": "string",
          "enum": ["complete", "reduced"]
        }
      },
      "required": ["shard", "sourceManifestHash", "consistency", "fidelity"],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "identity",
    "label",
    "source",
    "destination",
    "edgeScope",
    "properties",
    "metadata",
    "provenance"
  ],
  "additionalProperties": false,
  "$id": "urn:gremlin2rdf:schema:v1:canonical"
}
