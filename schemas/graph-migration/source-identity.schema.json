{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": ["vertex", "edge"]
    },
    "partition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
        },
        "lexical": {
          "type": "string"
        }
      },
      "required": ["type", "lexical"],
      "additionalProperties": false
    },
    "id": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
        },
        "lexical": {
          "type": "string"
        }
      },
      "required": ["type", "lexical"],
      "additionalProperties": false
    },
    "ownerId": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
            },
            "lexical": {
              "type": "string"
            }
          },
          "required": ["type", "lexical"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "edgeScope": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["sourcePartition", "sourceVertex"]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["schemaVersion", "kind", "partition", "id", "ownerId", "edgeScope"],
  "additionalProperties": false,
  "$id": "urn:gremlin2rdf:schema:v1:source-identity"
}
