{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "baseIri": {
      "type": "string"
    },
    "vocabulary": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "properties": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "edges": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derivedRelationships": {
      "type": "boolean"
    },
    "provenance": {
      "type": "boolean"
    },
    "fidelity": {
      "type": "string",
      "enum": ["strict", "reduced"]
    },
    "valueRules": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": ["string", "booleanValue", "integer", "floatValue", "doubleValue"]
          },
          "representation": {
            "type": "string",
            "enum": ["literal", "resource"]
          },
          "datatype": {
            "type": ["string", "null"]
          }
        },
        "required": ["sourceType", "representation", "datatype"],
        "additionalProperties": false
      }
    },
    "domainRules": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "minimumOccurrences": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maximumOccurrences": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["label", "property", "minimumOccurrences", "maximumOccurrences"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "baseIri",
    "vocabulary",
    "labels",
    "properties",
    "edges",
    "exclusions",
    "derivedRelationships",
    "provenance",
    "fidelity"
  ],
  "additionalProperties": false,
  "$id": "urn:gremlin2rdf:schema:v1:mapping"
}
