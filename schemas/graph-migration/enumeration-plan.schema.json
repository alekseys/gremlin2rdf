{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded read-only source enumeration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "partitions", "pageSize", "maximumRequests", "maximumDurationMillis"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "lexical"],
        "properties": {
          "type": { "enum": ["string", "integer", "booleanValue", "floatValue", "doubleValue"] },
          "lexical": { "type": "string" }
        }
      }
    },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "maximumRequests": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "maximumDurationMillis": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
  }
}
